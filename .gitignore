# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# Node / Vite
node_modules/
dist/
.vite/

# Test artifacts
test-results/
playwright-report/
coverage/

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Local app data (never commit user data / credentials)
*.db
*.sqlite
!spec/**

# integration test logs
src-tauri/out*.log
out.log

# Local Linux build artifacts
dist-linux/

# Collected beta installers (NSIS/.deb/AppImage) — large binaries, not tracked
release-beta/

# Bundled Oracle Instant Client — large + Oracle-licensed binaries, fetched per
# build (see src-tauri/resources/instantclient/README.md). Track only the README.
src-tauri/resources/instantclient/*
!src-tauri/resources/instantclient/README.md

# Backup & Restore client tools (pg_dump, mariadb-dump, mongodump) shipped in the
# installer — fetched per build by tools/fetch-dump-tools. Track only the README.
src-tauri/resources/tools/*
!src-tauri/resources/tools/README.md

# build output of the fetcher
tools/fetch-dump-tools/target/

# per-agent cargo target dirs (build output)
src-tauri/target-agents/
