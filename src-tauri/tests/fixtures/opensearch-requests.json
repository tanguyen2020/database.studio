    {
      "title": "Snapshot policies: create",
      "method": "POST",
      "path": "/_plugins/_sm/policies/it-sm",
      "body": {
        "description": "Nightly snapshot of every index, keep the last 7",
        "creation": {
          "schedule": {
            "cron": {
              "expression": "0 1 * * *",
              "timezone": "UTC"
            }
          }
        },
        "deletion": {
          "schedule": {
            "cron": {
              "expression": "0 2 * * *",
              "timezone": "UTC"
            }
          },
          "condition": {
            "max_count": 7,
            "min_count": 1
          }
        },
        "snapshot_config": {
          "repository": "it_repo",
          "indices": "*",
          "include_global_state": false,
          "date_format": "yyyy-MM-dd-HH:mm"
        }
      },
      "expect": [
        200,
        201
      ]
    },
