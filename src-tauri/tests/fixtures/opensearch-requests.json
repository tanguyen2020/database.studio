    {
      "title": "Index State Management policies: create",
      "method": "PUT",
      "path": "/_plugins/_ism/policies/it-ism",
      "body": {
        "policy": {
          "description": "Roll over hot indices daily, delete them after 30 days",
          "default_state": "hot",
          "states": [
            {
              "name": "hot",
              "actions": [
                {
                  "rollover": {
                    "min_index_age": "1d",
                    "min_primary_shard_size": "30gb"
                  }
                }
              ],
              "transitions": [
                {
                  "state_name": "delete",
                  "conditions": {
                    "min_index_age": "30d"
                  }
                }
              ]
            },
            {
              "name": "delete",
              "actions": [
                {
                  "delete": {}
                }
              ],
              "transitions": []
            }
          ],
          "ism_template": [
            {
              "index_patterns": [
                "it-ism-*"
              ],
              "priority": 100
            }
          ]
        }
      },
      "expect": [
        200,
        201
      ]
