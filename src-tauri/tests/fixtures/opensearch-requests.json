      "path": "/books",
      "expect": [
        200
      ],
      "body": {
        "settings": {
          "number_of_replicas": 0
        },
        "mappings": {
          "properties": {
            "title": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword"
                }
              }
            },
            "genre": {
              "type": "keyword"
            },
            "pages": {
              "type": "integer"
            },
            "published": {
              "type": "date"
            }
          }
        }
      }
    },
