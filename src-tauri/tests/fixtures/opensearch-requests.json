      "body": {
        "type": "monitor",
        "name": "it-monitors",
        "monitor_type": "query_level_monitor",
        "enabled": false,
        "schedule": {
          "period": {
            "interval": 5,
            "unit": "MINUTES"
          }
        },
        "inputs": [
          {
            "search": {
              "indices": [
                "books"
              ],
              "query": {
                "size": 0,
                "query": {
                  "range": {
                    "@timestamp": {
                      "gte": "{{period_end}}||-5m",
                      "lte": "{{period_end}}"
                    }
                  }
                }
              }
            }
          }
        ],
        "triggers": [
          {
            "name": "Any hit",
            "severity": "1",
            "condition": {
              "script": {
                "source": "ctx.results[0].hits.total.value > 0",
                "lang": "painless"
              }
            },
            "actions": []
          }
        ]
      },
      "expect": [
        200,
        201
      ],
      "save": {
        "name": "monitor",
        "field": "_id"
