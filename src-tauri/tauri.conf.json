{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Database Studio",
  "version": "0.1.0",
  "identifier": "studio.database.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": {
      "cwd": "..",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "..",
      "script": "npm run build"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Database Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0f1219"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
